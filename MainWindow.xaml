<Window x:Class="MclLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
  <Grid RequestedTheme="Default" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="MCL 启动助手" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
      <TextBlock Text="Minecraft BJD 玩家工具 · 管理员模式" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
    </StackPanel>
    <Border Grid.Row="1" Margin="0,24,0,16" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="5"><TextBlock Text="启动器目录" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/><TextBlock x:Name="LauncherPathText" Text="尚未检测" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="ScanButton" Content="快速检测" Click="ScanButton_Click"/><Button Content="手动选择" Click="ChooseButton_Click"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="4"><TextBlock Text="WPFLauncher.exe" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="LauncherStatus" Text="未检测" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
        <Border Grid.Column="1" Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="4"><TextBlock Text="injector.exe" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="InjectorStatus" Text="未启动" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
      </Grid>
      <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="8"><TextBlock Text="Mcl.Core.dll" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="PatchStatus" Text="请先检测启动器" FontSize="16" FontWeight="SemiBold"/><Button x:Name="PatchButton" Content="执行补丁" HorizontalAlignment="Left" IsEnabled="False" Click="PatchButton_Click"/></StackPanel></Border>
      <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="运行日志" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><ScrollViewer x:Name="LogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="True"><TextBlock x:Name="LogText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="Consolas"/></ScrollViewer></Grid></Border>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,18,0,0" Orientation="Horizontal" Spacing="10">
      <Button x:Name="DownloadButton" Content="下载网易启动器" Click="DownloadButton_Click"/>
      <Button x:Name="StartButton" Content="一键启动" IsEnabled="False" Click="StartButton_Click"/>
      <Button x:Name="StopButton" Content="退出运行" IsEnabled="False" Click="StopButton_Click"/>
      <Button x:Name="Reg4399Button" Content="4399 批量工具" Click="Reg4399Button_Click"/>
    </StackPanel>
  </Grid>
</Window>
